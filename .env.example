# Copy these settings into .env, then paste your Paystack test keys.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_MODE=
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/legacys
# Optional. On Render, set this to /var/data/uploads and mount a persistent disk at /var/data.
UPLOADS_DIR=
NODE_ENV=
TRUST_PROXY=
IMPORT_LEGACY_DATA=
ADMIN_EMAIL=store-admin@example.com
ADMIN_PASSWORD=
